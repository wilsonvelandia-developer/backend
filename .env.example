# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tournament_platform
POSTGRES_USER=tournament_user
POSTGRES_PASSWORD=change_me_in_production

# Full connection string (used by services and migrations)
DATABASE_URL=postgresql://tournament_user:change_me_in_production@localhost:5432/tournament_platform

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_use_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Service Ports
# ──────────────────────────────────────────────
GATEWAY_PORT=3000
SPORTS_PORT=3001
TOURNAMENTS_PORT=3002
TEAMS_PORT=3003
MATCHES_PORT=3004
STANDINGS_PORT=3005

# ──────────────────────────────────────────────
# Internal Service URLs (used by gateway)
# ──────────────────────────────────────────────
SPORTS_SERVICE_URL=http://localhost:3001
TOURNAMENTS_SERVICE_URL=http://localhost:3002
TEAMS_SERVICE_URL=http://localhost:3003
MATCHES_SERVICE_URL=http://localhost:3004
STANDINGS_SERVICE_URL=http://localhost:3005

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
