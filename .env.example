# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tournament_platform
POSTGRES_USER=tournament_user
POSTGRES_PASSWORD=change_me_in_production

# Full connection string (used by services and migrations)
DATABASE_URL=postgresql://tournament_user:change_me_in_production@localhost:5432/tournament_platform

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_use_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Service Ports
# ──────────────────────────────────────────────
GATEWAY_PORT=3000
SPORTS_PORT=3001
TOURNAMENTS_PORT=3002
TEAMS_PORT=3003
MATCHES_PORT=3004
STANDINGS_PORT=3005
VENUES_PORT=3006
ANNOUNCEMENTS_PORT=3007
PAYMENTS_PORT=3008
GALLERY_PORT=3009

# ──────────────────────────────────────────────
# Internal Service URLs (used by gateway)
# ──────────────────────────────────────────────
SPORTS_SERVICE_URL=http://localhost:3001
TOURNAMENTS_SERVICE_URL=http://localhost:3002
TEAMS_SERVICE_URL=http://localhost:3003
MATCHES_SERVICE_URL=http://localhost:3004
STANDINGS_SERVICE_URL=http://localhost:3005
VENUES_SERVICE_URL=http://localhost:3006
ANNOUNCEMENTS_SERVICE_URL=http://localhost:3007
PAYMENTS_SERVICE_URL=http://localhost:3008
GALLERY_SERVICE_URL=http://localhost:3009

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

# ──────────────────────────────────────────────
# Email (SMTP) — for password reset emails
# ──────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=OlimpicApp <no-reply@olimpicapp.com>

# ──────────────────────────────────────────────
# Frontend URL (for building links in emails)
# ──────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

# ──────────────────────────────────────────────
# File Storage (for uploads: images, documents, PDFs)
# ──────────────────────────────────────────────
# Provider: 'firebase' or 'local' (default: local for development)
STORAGE_PROVIDER=local

# Firebase Storage (production)
# FIREBASE_STORAGE_BUCKET=olimpicapp-b1a70.appspot.com
# FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
# (Or set as inline JSON string for containerized environments)

# Local Storage (development fallback)
LOCAL_UPLOAD_DIR=./uploads
LOCAL_UPLOAD_BASE_URL=http://localhost:3000/uploads
