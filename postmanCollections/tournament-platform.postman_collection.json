{
  "info": {
    "name": "Tournament Platform API — Complete",
    "description": "Multi-sport tournament management. Incluye auth, RBAC, CRUD completo y flujos de partido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "admin_email", "value": "admin@olimpic.app" },
    { "key": "admin_pass", "value": "admin123" },
    { "key": "test_pass", "value": "test123" },
    { "key": "tournament_id", "value": "a1b2c3d4-0001-0000-0000-000000000000" },
    { "key": "phase_id", "value": "a1b2c3d4-0002-0000-0000-000000000000" },
    { "key": "team_id", "value": "b0000001-0000-0000-0000-000000000001" },
    { "key": "sport_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login — Admin",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{admin_email}}\",\"password\":\"{{admin_pass}}\"}" }
          }
        },
        {
          "name": "Login — Organizador",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"organizador@test.com\",\"password\":\"{{test_pass}}\"}" }
          }
        },
        {
          "name": "Login — Entrenador",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"entrenador@test.com\",\"password\":\"{{test_pass}}\"}" }
          }
        },
        {
          "name": "Login — Jugador (read-only)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"jugador@test.com\",\"password\":\"{{test_pass}}\"}" }
          }
        },
        {
          "name": "Login — Árbitro",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"arbitro@test.com\",\"password\":\"{{test_pass}}\"}" }
          }
        },
        {
          "name": "GET /auth/me",
          "request": { "method": "GET", "url": "{{base_url}}/auth/me" }
        },
        {
          "name": "POST /auth/logout",
          "request": { "method": "POST", "url": "{{base_url}}/auth/logout" }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"nuevo@test.com\",\"password\":\"test123\",\"name\":\"Usuario Nuevo\",\"roles\":[\"player\"]}" }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /api/users — Listar usuarios",
          "request": { "method": "GET", "url": "{{base_url}}/api/users" }
        }
      ]
    },
    {
      "name": "Sports",
      "item": [
        { "name": "GET /api/sports", "request": { "method": "GET", "url": "{{base_url}}/api/sports" } },
        { "name": "GET /api/sports/:id", "request": { "method": "GET", "url": "{{base_url}}/api/sports/{{sport_id}}" } },
        {
          "name": "POST /api/sports — Crear deporte",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/sports",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-user-role", "value": "admin" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Futsal\",\"slug\":\"futsal\",\"playersPerTeam\":5,\"hasSets\":false,\"periodsPerMatch\":2,\"maxSubstitutions\":null,\"hasRotation\":false}" }
          }
        }
      ]
    },
    {
      "name": "Tournaments",
      "item": [
        { "name": "GET /api/tournaments", "request": { "method": "GET", "url": "{{base_url}}/api/tournaments" } },
        { "name": "GET /api/tournaments/:id", "request": { "method": "GET", "url": "{{base_url}}/api/tournaments/{{tournament_id}}" } },
        {
          "name": "POST /api/tournaments — Crear torneo",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/tournaments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"sportId\":\"{{sport_id}}\",\"name\":\"Torneo Postman Test\",\"season\":\"2026\",\"category\":\"Sub-18\",\"expectedTeams\":8,\"numGroups\":2}" }
          }
        },
        {
          "name": "PUT /api/tournaments/:id — Actualizar",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/tournaments/{{tournament_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"active\",\"contactPhone\":\"+57 300 555 1234\"}" }
          }
        },
        { "name": "GET /api/tournaments/:id/phases", "request": { "method": "GET", "url": "{{base_url}}/api/tournaments/{{tournament_id}}/phases" } },
        {
          "name": "POST /api/tournaments/:id/phases",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/tournaments/{{tournament_id}}/phases",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Fase Test\",\"format\":\"round_robin\",\"orderIndex\":10}" }
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        { "name": "GET /api/teams", "request": { "method": "GET", "url": "{{base_url}}/api/teams" } },
        { "name": "GET /api/teams?tournamentId", "request": { "method": "GET", "url": "{{base_url}}/api/teams?tournamentId={{tournament_id}}" } },
        { "name": "GET /api/teams/:id", "request": { "method": "GET", "url": "{{base_url}}/api/teams/{{team_id}}" } },
        {
          "name": "POST /api/teams — Crear equipo",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/teams",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"tournamentId\":\"{{tournament_id}}\",\"name\":\"Equipo Postman\",\"shortName\":\"PST\"}" }
          }
        },
        { "name": "GET /api/teams/:id/players", "request": { "method": "GET", "url": "{{base_url}}/api/teams/{{team_id}}/players" } },
        {
          "name": "POST /api/teams/:id/players — Agregar jugador",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/teams/{{team_id}}/players",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Jugador Postman\",\"jerseyNumber\":99,\"position\":\"setter\"}" }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        { "name": "GET /api/matches", "request": { "method": "GET", "url": "{{base_url}}/api/matches" } },
        { "name": "GET /api/matches?phaseId", "request": { "method": "GET", "url": "{{base_url}}/api/matches?phaseId={{phase_id}}" } },
        {
          "name": "POST /api/matches — Programar",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/matches",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phaseId\":\"{{phase_id}}\",\"homeTeamId\":\"b0000001-0000-0000-0000-000000000001\",\"awayTeamId\":\"b0000001-0000-0000-0000-000000000002\"}" }
          }
        },
        { "name": "PUT /api/matches/:id/start", "request": { "method": "PUT", "url": "{{base_url}}/api/matches/MATCH_ID_HERE/start" } },
        {
          "name": "PUT /api/matches/:id/periods/1/score",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/api/matches/MATCH_ID_HERE/periods/1/score",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"homeScore\":25,\"awayScore\":20}" }
          }
        },
        { "name": "PUT /api/matches/:id/finish", "request": { "method": "PUT", "url": "{{base_url}}/api/matches/MATCH_ID_HERE/finish" } }
      ]
    },
    {
      "name": "Standings",
      "item": [
        { "name": "GET /api/standings/:phaseId", "request": { "method": "GET", "url": "{{base_url}}/api/standings/{{phase_id}}" } },
        {
          "name": "POST /api/standings/recalculate",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/standings/recalculate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"phaseId\":\"{{phase_id}}\"}" }
          }
        }
      ]
    },
    {
      "name": "RBAC Tests",
      "description": "Pruebas de permisos por rol",
      "item": [
        {
          "name": "Jugador intenta crear torneo → 403",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/tournaments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"sportId\":\"fake\",\"name\":\"No debería crearse\"}" }
          }
        },
        {
          "name": "Jugador intenta crear equipo → 403",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/teams",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"tournamentId\":\"fake\",\"name\":\"No equipo\"}" }
          }
        },
        {
          "name": "Jugador GET torneos → 200 (lectura OK)",
          "request": { "method": "GET", "url": "{{base_url}}/api/tournaments" }
        }
      ]
    }
  ]
}
