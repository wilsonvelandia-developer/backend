  "item": [
    {
      "name": "Gateway",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/health"
          }
        },
        {
          "name": "401 — Sin token",
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/api/sports"
          }
        }
      ]
    },
    {
      "name": "Sports",
      "item": [
        {
          "name": "Listar deportes",
          "request": {
            "method": "GET",
            "url": "{{sports_url}}/sports"
          }
        },
        {
          "name": "Obtener deporte por ID",
          "request": {
            "method": "GET",
            "url": "{{sports_url}}/sports/{{sport_id}}"
          }
        },
        {
          "name": "Crear deporte",
          "request": {
            "method": "POST",
            "url": "{{sports_url}}/sports",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-role",  "value": "admin" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Handball\",\n  \"slug\": \"handball\",\n  \"playersPerTeam\": 7,\n  \"hasSets\": false,\n  \"winMargin\": 2,\n  \"periodsPerMatch\": 2,\n  \"maxSubstitutions\": null,\n  \"hasRotation\": false\n}"
            }
          }
        },
        {
          "name": "Actualizar deporte",
          "request": {
            "method": "PUT",
            "url": "{{sports_url}}/sports/{{sport_id}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-role",  "value": "admin" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxSubstitutions\": 6\n}"
            }
          }
        },
        {
          "name": "Eliminar deporte",
          "request": {
            "method": "DELETE",
            "url": "{{sports_url}}/sports/{{sport_id}}",
            "header": [{ "key": "x-user-role", "value": "admin" }]
          }
        }
      ]
    },
    {
      "name": "Tournaments",
      "item": [
        {
          "name": "Listar torneos",
          "request": {
            "method": "GET",
            "url": "{{tournaments_url}}/tournaments"
          }
        },
        {
          "name": "Listar torneos — filtrar por deporte",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{tournaments_url}}/tournaments?sportId={{sport_id}}",
              "query": [{ "key": "sportId", "value": "{{sport_id}}" }]
            }
          }
        },
        {
          "name": "Crear torneo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const r = pm.response.json(); pm.collectionVariables.set('tournament_id', r.data.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{tournaments_url}}/tournaments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sportId\": \"{{sport_id}}\",\n  \"name\": \"Torneo de Prueba 2026\",\n  \"season\": \"2026\"\n}"
            }
          }
        },
        {
          "name": "Obtener torneo",
          "request": {
            "method": "GET",
            "url": "{{tournaments_url}}/tournaments/{{tournament_id}}"
          }
        },
        {
          "name": "Actualizar torneo — activar",
          "request": {
            "method": "PUT",
            "url": "{{tournaments_url}}/tournaments/{{tournament_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\"\n}" }
          }
        },
        {
          "name": "Agregar fase — Grupos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const r = pm.response.json(); pm.collectionVariables.set('phase_id', r.data.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{tournaments_url}}/tournaments/{{tournament_id}}/phases",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fase de Grupos\",\n  \"format\": \"round_robin\",\n  \"orderIndex\": 1\n}"
            }
          }
        },
        {
          "name": "Listar fases",
          "request": {
            "method": "GET",
            "url": "{{tournaments_url}}/tournaments/{{tournament_id}}/phases"
          }
        }
      ]
    },
    {
      "name": "Teams",
      "item": [
        {
          "name": "Crear equipo A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const r = pm.response.json(); pm.collectionVariables.set('team_id', r.data.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{teams_url}}/teams",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tournamentId\": \"{{tournament_id}}\",\n  \"name\": \"Equipo Alpha\",\n  \"shortName\": \"ALP\"\n}"
            }
          }
        },
        {
          "name": "Listar equipos del torneo",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{teams_url}}/teams?tournamentId={{tournament_id}}",
              "query": [{ "key": "tournamentId", "value": "{{tournament_id}}" }]
            }
          }
        },
        {
          "name": "Agregar jugador (setter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const r = pm.response.json(); pm.collectionVariables.set('player_id', r.data.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{teams_url}}/teams/{{team_id}}/players",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Gomez\",\n  \"jerseyNumber\": 1,\n  \"position\": \"setter\"\n}"
            }
          }
        },
        {
          "name": "Listar jugadores del equipo",
          "request": {
            "method": "GET",
            "url": "{{teams_url}}/teams/{{team_id}}/players"
          }
        },
        {
          "name": "Actualizar jugador — desactivar",
          "request": {
            "method": "PUT",
            "url": "{{teams_url}}/teams/{{team_id}}/players/{{player_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "Programar partido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["const r = pm.response.json(); pm.collectionVariables.set('match_id', r.data.id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{matches_url}}/matches",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phaseId\": \"{{phase_id}}\",\n  \"homeTeamId\": \"TEAM_A_ID\",\n  \"awayTeamId\": \"TEAM_B_ID\"\n}"
            }
          }
        },
        {
          "name": "Iniciar partido",
          "request": {
            "method": "PUT",
            "url": "{{matches_url}}/matches/{{match_id}}/start"
          }
        },
        {
          "name": "Obtener partido con períodos",
          "request": {
            "method": "GET",
            "url": "{{matches_url}}/matches/{{match_id}}"
          }
        },
        {
          "name": "Actualizar marcador — Set 1 (25-20)",
          "request": {
            "method": "PUT",
            "url": "{{matches_url}}/matches/{{match_id}}/periods/1/score",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"homeScore\": 25,\n  \"awayScore\": 20\n}" }
          }
        },
        {
          "name": "Actualizar marcador — Set 1 inválido (26-25)",
          "request": {
            "method": "PUT",
            "url": "{{matches_url}}/matches/{{match_id}}/periods/1/score",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"homeScore\": 26,\n  \"awayScore\": 25\n}" }
          }
        },
        {
          "name": "Registrar alineación (voleibol)",
          "request": {
            "method": "POST",
            "url": "{{matches_url}}/matches/{{match_id}}/lineups",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{team_id}}\",\n  \"setNumber\": 1,\n  \"lineup\": [\n    { \"position\": 1, \"playerId\": \"PLAYER_1_ID\" },\n    { \"position\": 2, \"playerId\": \"PLAYER_2_ID\" },\n    { \"position\": 3, \"playerId\": \"PLAYER_3_ID\" },\n    { \"position\": 4, \"playerId\": \"PLAYER_4_ID\" },\n    { \"position\": 5, \"playerId\": \"PLAYER_5_ID\" },\n    { \"position\": 6, \"playerId\": \"PLAYER_6_ID\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Aplicar rotación (voleibol)",
          "request": {
            "method": "POST",
            "url": "{{matches_url}}/matches/{{match_id}}/rotate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"teamId\": \"{{team_id}}\",\n  \"setNumber\": 1\n}" }
          }
        },
        {
          "name": "Registrar sustitución",
          "request": {
            "method": "POST",
            "url": "{{matches_url}}/matches/{{match_id}}/substitutions",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teamId\": \"{{team_id}}\",\n  \"periodNumber\": 1,\n  \"playerOutId\": \"PLAYER_OUT_ID\",\n  \"playerInId\": \"PLAYER_IN_ID\"\n}"
            }
          }
        },
        {
          "name": "Ver sustituciones del partido",
          "request": {
            "method": "GET",
            "url": "{{matches_url}}/matches/{{match_id}}/substitutions"
          }
        },
        {
          "name": "Finalizar partido",
          "request": {
            "method": "PUT",
            "url": "{{matches_url}}/matches/{{match_id}}/finish"
          }
        },
        {
          "name": "Listar partidos por fase",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{matches_url}}/matches?phaseId={{phase_id}}",
              "query": [{ "key": "phaseId", "value": "{{phase_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Standings",
      "item": [
        {
          "name": "Tabla de posiciones",
          "request": {
            "method": "GET",
            "url": "{{standings_url}}/standings/{{phase_id}}"
          }
        },
        {
          "name": "Recalcular standings",
          "request": {
            "method": "POST",
            "url": "{{standings_url}}/standings/recalculate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phaseId\": \"{{phase_id}}\"\n}" }
          }
        }
      ]
    },
