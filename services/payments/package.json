{
  "name": "@tournament/payments",
  "version": "1.0.0",
  "description": "Payments service — tournament fee tracking and records",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --build --force",
    "build:watch": "tsc --watch",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tournament/shared": "*",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "helmet": "8.0.0",
    "pg": "8.16.0",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "uuid": "11.1.1",
    "zod": "3.25.51"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.29",
    "@types/pg": "8.15.4",
    "@types/uuid": "10.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vitest": "3.2.1"
  }
}
